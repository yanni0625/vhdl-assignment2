  <vhdl appearance="logisim_evolution" name="p5">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity p5 is
    port (
        vt : in  std_logic_vector(12 downto 0);
        en : in  std_logic;
        a  : out std_logic;
        b  : out std_logic;
        c  : out std_logic;
        d  : out std_logic;
        e  : out std_logic;
        f  : out std_logic;
        g  : out std_logic
    );
end entity p5;

architecture behavioral of p5 is
    signal seg : std_logic_vector(6 downto 0);  -- a b c d e f g
begin
    process (vt, en)
        variable n : integer range 0 to 13;
    begin
        n := 0;
        for i in 0 to 12 loop
            if vt(i) = '1' then
                n := n + 1;
            end if;
        end loop;

        if en = '0' then
            seg &lt;= "0000000";
        else
            case n is
                when 0  =&gt; seg &lt;= "1111110";  -- 0
                when 1  =&gt; seg &lt;= "0110000";  -- 1
                when 2  =&gt; seg &lt;= "1101101";  -- 2
                when 3  =&gt; seg &lt;= "1111001";  -- 3
                when 4  =&gt; seg &lt;= "0110011";  -- 4
                when 5  =&gt; seg &lt;= "1011011";  -- 5
                when 6  =&gt; seg &lt;= "1011111";  -- 6
                when 7  =&gt; seg &lt;= "1110000";  -- 7
                when 8  =&gt; seg &lt;= "1111111";  -- 8
                when 9  =&gt; seg &lt;= "1111011";  -- 9
                when 10 =&gt; seg &lt;= "1110111";  -- A
                when 11 =&gt; seg &lt;= "0011111";  -- b
                when 12 =&gt; seg &lt;= "1001110";  -- C
                when 13 =&gt; seg &lt;= "0111101";  -- d
            end case;
        end if;
    end process;

    a &lt;= seg(6);
    b &lt;= seg(5);
    c &lt;= seg(4);
    d &lt;= seg(3);
    e &lt;= seg(2);
    f &lt;= seg(1);
    g &lt;= seg(0);
end architecture behavioral;</vhdl>
