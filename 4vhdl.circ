  <lib desc="#Wiring" name="0">
    <tool name="Pin">
      <a name="appearance" val="classic"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#FPArithmetic" name="4"/>
  <lib desc="#Memory" name="5"/>
  <lib desc="#I/O" name="6"/>
  <lib desc="#TTL" name="7"/>
  <lib desc="#TCL" name="8"/>
  <lib desc="#Base" name="9"/>
  <lib desc="#BFH-Praktika" name="10"/>
  <lib desc="#Input/Output-Extra" name="11"/>
  <lib desc="#Soc" name="12"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool map="Button2" name="Poke Tool"/>
    <tool map="Button3" name="Menu Tool"/>
    <tool map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool name="Poke Tool"/>
    <tool name="Edit Tool"/>
    <tool name="Wiring Tool"/>
    <tool name="Text Tool"/>
    <tool name="Image"/>
    <sep/>
    <tool name="Pin"/>
    <tool name="Pin">
      <a name="facing" val="west"/>
      <a name="type" val="output"/>
    </tool>
    <sep/>
    <tool name="NOT Gate"/>
    <tool name="AND Gate"/>
    <tool name="OR Gate"/>
    <tool name="XOR Gate"/>
    <tool name="NAND Gate"/>
    <tool name="NOR Gate"/>
    <sep/>
    <tool name="D Flip-Flop"/>
    <tool name="Register"/>
  </toolbar>
  <circuit name="main">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="main"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(420,400)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="radix" val="16"/>
      <a name="width" val="25"/>
    </comp>
    <comp lib="0" loc="(640,400)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="0" loc="(640,420)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="radix" val="10signed"/>
      <a name="type" val="output"/>
      <a name="width" val="5"/>
    </comp>
    <comp loc="(640,400)" name="p4"/>
  </circuit>
  <vhdl appearance="logisim_evolution" name="p4">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity p4 is
    port (
        v    : in  std_logic_vector(24 downto 0);
        pass : out std_logic;
        cnt  : out std_logic_vector(4 downto 0)
    );
end entity p4;

architecture behavioral of p4 is
begin
    process (v)
        variable n : integer range 0 to 25;
    begin
        n := 0;
        for i in 0 to 24 loop
            if v(i) = '1' then
                n := n + 1;
            end if;
        end loop;

        cnt &lt;= std_logic_vector(to_unsigned(n, 5));

        if n &gt;= 13 then
            pass &lt;= '1';
        else
            pass &lt;= '0';
        end if;
    end process;
end architecture behavioral;</vhdl>
