  <vhdl appearance="logisim_evolution" name="p3">library ieee;
use ieee.std_logic_1164.all;

entity p3 is
    port (
        x : in  std_logic_vector(2 downto 0);
        a : out std_logic;
        b : out std_logic;
        c : out std_logic;
        d : out std_logic;
        e : out std_logic;
        f : out std_logic;
        g : out std_logic
    );
end entity p3;

architecture behavioral of p3 is
    signal seg : std_logic_vector(6 downto 0);  -- a b c d e f g
begin
    with x select
        seg &lt;= "1110111" when "000",  -- A
               "0011111" when "001",  -- b
               "1001110" when "010",  -- C
               "0111101" when "011",  -- d
               "1000111" when "100",  -- F
               "1011110" when "101",  -- G
               "0000000" when others;

    a &lt;= seg(6);
    b &lt;= seg(5);
    c &lt;= seg(4);
    d &lt;= seg(3);
    e &lt;= seg(2);
    f &lt;= seg(1);
    g &lt;= seg(0);
end architecture behavioral;</vhdl>
